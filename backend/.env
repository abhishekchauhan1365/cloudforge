# Flask Backend Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=super-secret-key-change-in-prod
JWT_SECRET_KEY=super-secret-jwt-key-change-in-prod
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cloudforge

# AWS Configuration (Used by Backend, Terraform, and Lambda)
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
AWS_DEFAULT_REGION=us-east-1

# Jenkins Configuration
JENKINS_URL=http://localhost:8080
JENKINS_USER=admin
JENKINS_TOKEN=your_api_token
